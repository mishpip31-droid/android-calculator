<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">?attr/c_background</item>
        <item name="android:statusBarColor">?attr/c_background</item>
        <item name="android:navigationBarColor">?attr/c_background</item>
        <item name="c_background">@color/background</item>
        <item name="c_text_primary">@color/text_primary</item>
        <item name="c_text_secondary">@color/text_secondary</item>
        <item name="c_error">@color/error</item>
        <item name="c_btn_digit">@color/btn_digit</item>
        <item name="c_btn_func">@color/btn_func</item>
        <item name="c_btn_op">@color/btn_op</item>
        <item name="c_btn_op_text">@color/btn_op_text</item>
        <item name="c_btn_equals">@color/btn_equals</item>
        <item name="c_btn_equals_text">@color/btn_equals_text</item>
        <item name="c_ripple">@color/ripple</item>
        <item name="c_accent">@color/accent</item>
        <item name="c_card">@color/card</item>
        <item name="c_best">@color/best</item>
        <item name="c_divider">@color/divider</item>
        <item name="c_undo_bg">@color/undo_bg</item>
        <item name="c_undo_text">@color/undo_text</item>
        <item name="c_undo_action">@color/undo_action</item>
        <item name="c_danger">@color/danger</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">?attr/c_text_primary</item>
        <item name="android:background">@drawable/btn_digit</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="CalcButton.Func">
        <item name="android:background">@drawable/btn_func</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CalcButton.Op">
        <item name="android:background">@drawable/btn_op</item>
        <item name="android:textColor">?attr/c_btn_op_text</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="CalcButton.Equals">
        <item name="android:background">@drawable/btn_equals</item>
        <item name="android:textColor">?attr/c_btn_equals_text</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="AboutHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">?attr/c_accent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AboutItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">?attr/c_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="CalcRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>
</resources>
