<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Экран -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <HorizontalScrollView
            android:id="@+id/expressionScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="52sp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="start"
            android:gravity="end"
            android:maxLines="1"
            android:minHeight="40dp"
            android:textColor="@color/text_secondary"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- Клавиатура -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="vertical">

        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btnClear"
                style="@style/CalcButton.Func"
                android:contentDescription="@string/desc_clear"
                android:text="C" />
            <Button
                android:id="@+id/btnParen"
                style="@style/CalcButton.Func"
                android:contentDescription="@string/desc_paren"
                android:text="( )" />
            <Button
                android:id="@+id/btnPercent"
                style="@style/CalcButton.Func"
                android:text="%" />
            <Button
                android:id="@+id/btnDivide"
                style="@style/CalcButton.Op"
                android:text="÷" />
        </LinearLayout>
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btn7"
                style="@style/CalcButton"
                android:text="7" />
            <Button
                android:id="@+id/btn8"
                style="@style/CalcButton"
                android:text="8" />
            <Button
                android:id="@+id/btn9"
                style="@style/CalcButton"
                android:text="9" />
            <Button
                android:id="@+id/btnMultiply"
                style="@style/CalcButton.Op"
                android:text="×" />
        </LinearLayout>
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btn4"
                style="@style/CalcButton"
                android:text="4" />
            <Button
                android:id="@+id/btn5"
                style="@style/CalcButton"
                android:text="5" />
            <Button
                android:id="@+id/btn6"
                style="@style/CalcButton"
                android:text="6" />
            <Button
                android:id="@+id/btnMinus"
                style="@style/CalcButton.Op"
                android:text="−" />
        </LinearLayout>
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btn1"
                style="@style/CalcButton"
                android:text="1" />
            <Button
                android:id="@+id/btn2"
                style="@style/CalcButton"
                android:text="2" />
            <Button
                android:id="@+id/btn3"
                style="@style/CalcButton"
                android:text="3" />
            <Button
                android:id="@+id/btnPlus"
                style="@style/CalcButton.Op"
                android:text="+" />
        </LinearLayout>
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btnBackspace"
                style="@style/CalcButton.Func"
                android:contentDescription="@string/desc_backspace"
                android:text="⌫" />
            <Button
                android:id="@+id/btn0"
                style="@style/CalcButton"
                android:text="0" />
            <Button
                android:id="@+id/btnDot"
                style="@style/CalcButton"
                android:text="." />
            <Button
                android:id="@+id/btnEquals"
                style="@style/CalcButton.Equals"
                android:text="=" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
