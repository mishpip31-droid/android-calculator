<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- Панель: история / очистка истории -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnToggleHistory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/icon_button_bg"
            android:contentDescription="@string/desc_history"
            android:src="@drawable/ic_history" />

        <!-- В свёрнутом виде — пустое место, в режиме истории — поиск и фильтр. -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="invisible">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/search_bg"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="6dp"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="?attr/c_text_primary"
                android:textColorHint="?attr/c_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnNotesOnly"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:background="@drawable/toggle_bg"
                android:clickable="true"
                android:contentDescription="@string/desc_notes_only"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/notes_only"
                android:textColor="@color/toggle_text"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnQuickSum"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/pill_bg"
            android:clickable="true"
            android:contentDescription="@string/desc_quick_sum"
            android:focusable="true"
            android:gravity="center"
            android:text="Σ"
            android:textColor="?attr/c_btn_op_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnShopping"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/pill_bg"
            android:clickable="true"
            android:contentDescription="@string/desc_shopping"
            android:drawableStart="@drawable/ic_cart_small"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:text="@string/shopping"
            android:textColor="?attr/c_btn_op_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnConverter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/pill_bg"
            android:clickable="true"
            android:contentDescription="@string/desc_converter"
            android:drawableStart="@drawable/ic_currency"
            android:drawablePadding="6dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:text="@string/converter"
            android:textColor="?attr/c_btn_op_text"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@drawable/icon_button_bg"
            android:contentDescription="@string/desc_info"
            android:src="@drawable/ic_info" />

        <ImageButton
            android:id="@+id/btnClearHistory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/icon_button_bg"
            android:contentDescription="@string/desc_clear_history"
            android:src="@drawable/ic_delete"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Экран: лента истории над текущим выражением -->
    <LinearLayout
        android:id="@+id/displayArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:fadingEdgeLength="32dp"
                android:requiresFadingEdge="vertical"
                android:scrollbarStyle="outsideOverlay"
                android:stackFromBottom="true"
                android:transcriptMode="normal" />

            <GridView
                android:id="@+id/historyGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:columnWidth="150dp"
                android:drawSelectorOnTop="false"
                android:horizontalSpacing="8dp"
                android:listSelector="@android:color/transparent"
                android:numColumns="auto_fit"
                android:padding="4dp"
                android:stretchMode="columnWidth"
                android:verticalSpacing="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/historyEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/history_empty"
                android:textColor="?attr/c_text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <HorizontalScrollView
                android:id="@+id/expressionScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/expression"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="?attr/c_text_primary"
                    android:textIsSelectable="true"
                    android:textSize="48sp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:gravity="end"
                android:maxLines="1"
                android:minHeight="36dp"
                android:textColor="?attr/c_text_secondary"
                android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Клавиатура -->
    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical">

        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btnClear"
                style="@style/CalcButton.Func"
                android:contentDescription="@string/desc_clear"
                android:text="C" />
            <Button
                android:id="@+id/btnParen"
                style="@style/CalcButton.Func"
                android:contentDescription="@string/desc_paren"
                android:text="( )" />
            <Button
                android:id="@+id/btnPercent"
                style="@style/CalcButton.Func"
                android:text="%" />
            <Button
                android:id="@+id/btnDivide"
                style="@style/CalcButton.Op"
                android:text="÷" />
        </LinearLayout>
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btn7"
                style="@style/CalcButton"
                android:text="7" />
            <Button
                android:id="@+id/btn8"
                style="@style/CalcButton"
                android:text="8" />
            <Button
                android:id="@+id/btn9"
                style="@style/CalcButton"
                android:text="9" />
            <Button
                android:id="@+id/btnMultiply"
                style="@style/CalcButton.Op"
                android:text="×" />
        </LinearLayout>
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btn4"
                style="@style/CalcButton"
                android:text="4" />
            <Button
                android:id="@+id/btn5"
                style="@style/CalcButton"
                android:text="5" />
            <Button
                android:id="@+id/btn6"
                style="@style/CalcButton"
                android:text="6" />
            <Button
                android:id="@+id/btnMinus"
                style="@style/CalcButton.Op"
                android:text="−" />
        </LinearLayout>
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btn1"
                style="@style/CalcButton"
                android:text="1" />
            <Button
                android:id="@+id/btn2"
                style="@style/CalcButton"
                android:text="2" />
            <Button
                android:id="@+id/btn3"
                style="@style/CalcButton"
                android:text="3" />
            <Button
                android:id="@+id/btnPlus"
                style="@style/CalcButton.Op"
                android:text="+" />
        </LinearLayout>
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btnBackspace"
                style="@style/CalcButton.Func"
                android:contentDescription="@string/desc_backspace"
                android:text="⌫" />
            <Button
                android:id="@+id/btn0"
                style="@style/CalcButton"
                android:text="0" />
            <Button
                android:id="@+id/btnDot"
                style="@style/CalcButton"
                android:text="." />
            <Button
                android:id="@+id/btnEquals"
                style="@style/CalcButton.Equals"
                android:text="=" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
