<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_bg"
    android:gravity="center_vertical"
    android:minHeight="88dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/currencyCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/c_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/currencyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/c_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/currencyRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/c_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/currencyAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:background="@null"
        android:digits="0123456789.,+−-×÷*/() "
        android:gravity="end|center_vertical"
        android:hint="0"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:selectAllOnFocus="false"
        android:textColor="?attr/c_text_primary"
        android:textColorHint="?attr/c_text_secondary"
        android:textSize="28sp" />

    <!-- Появляется, когда строка выбрана и в ней есть сумма: очищает все строки -->
    <ImageButton
        android:id="@+id/currencyClear"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/icon_button_bg"
        android:contentDescription="@string/desc_clear_amount"
        android:src="@drawable/ic_clear"
        android:visibility="gone" />
</LinearLayout>
